pipeline {
    agent any

    tools {
        nodejs 'nodejs23'
    }

    environment {
        APP_DIR = "/opt/Jenkins-DemoProject"
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main',
                url: 'https://github.com/Mohan0375/Jenkins-DemoProject.git'
            }
        }
        stage('Install Backend Dependencies') {
            steps {
                dir('api') {
                    sh 'npm install'
                }
            }
        }

        stage('Install Frontend Dependencies') {
            steps {
                dir('client') {
                    sh 'npm install'
                }
            }
        }

        stage('Deploy Backend') {
            steps {
                sh '''
                rsync -av --delete --exclude=.env api/ $APP_DIR/api/

                cd $APP_DIR/api

                npm install

                /usr/bin/pm2 restart backend || /usr/bin/pm2 start app.js --name backend
                '''
            }
        }

        stage('Deploy Frontend') {
            steps {
                sh '''
                rsync -av --delete --exclude=.env client/ $APP_DIR/client/

                cd $APP_DIR/client

                npm install

                rm -rf node_modules/.cache

                /usr/bin/pm2 restart frontend || /usr/bin/pm2 start npm --name frontend -- start
                '''
            }
        }
    }
     post {
        success {
            echo 'Pipeline executed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}
