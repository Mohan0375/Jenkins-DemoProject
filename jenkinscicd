pipeline {
    agent any

    tools {
        nodejs 'nodejs23'
    }

    environment {
        APP_DIR = "/home/ubuntu/Jenkins-DemoProject"
        PM2_PATH = "/usr/bin/pm2"
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/Mohan0375/Jenkins-DemoProject.git'
            }
        }

        stage('Frontend Compilation') {
            steps {
                dir('client') {
                    sh 'find . -name "*.js" -exec node --check {} +'
                }
            }
        }

        stage('Backend Compilation') {
            steps {
                dir('api') {
                    sh 'find . -name "*.js" -exec node --check {} +'
                }
            }
        }

        stage('Install Backend Dependencies') {
            steps {
                dir('api') {
                    sh 'npm install'
                }
            }
        }

        stage('Install Frontend Dependencies') {
            steps {
                dir('client') {
                    sh 'npm install'
                }
            }
        }

		stage('Deploy Backend') {
			steps {
				sh '''
				rsync -av --delete --exclude='.env' api/ $APP_DIR/api/

				cd $APP_DIR/api

				npm install

				sudo su - ubuntu -c "
				export PATH=$PATH:/usr/bin

				cd $APP_DIR/api

				pm2 restart backend || pm2 start app.js --name backend
				"
				'''
			}
		}

		stage('Deploy Frontend') {
			steps {
				sh '''
				rsync -av --delete --exclude='.env' client/ $APP_DIR/client/

				cd $APP_DIR/client

				npm install

				sudo su - ubuntu -c "
				export PATH=$PATH:/usr/bin

				pm2 delete frontend || true

				cd $APP_DIR/client

				HOST=0.0.0.0 pm2 start npm --name frontend -- start
				"
				'''
			}
		}

    }

    post {
        success {
            echo 'Pipeline executed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}
